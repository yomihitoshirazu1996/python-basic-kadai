      "source": [
        "planet_list = [\"水\",\"金\",\"地\",\"火\",\"木\",\"土\",\"天\",\"海\",\"冥\"]\n",
        "\n",
        "# インデックスを初期化\n",
        "i = 0\n",
        "\n",
        "# リストの長さまでループを続ける\n",
        "while i < len(planet_list):\n",
        "    print(planet_list[i])\n",
        "    # 次の要素へ進むためにインデックスをインクリメント\n",
        "    i += 1"
      ],
